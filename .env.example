# Drops Web Backend — environment variables (example)
# Copy to .env for local dev, or set these in Render's env/secret store.
# NEVER commit real secrets (see AGENTS.md §4).

# --- Auth / web (existing) --------------------------------------------------
DROPS_WEB_USERNAME=dj
# Argon2id hash of the password (generate with argon2-cffi PasswordHasher().hash("..."))
DROPS_WEB_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
DROPS_WEB_ENV=production
DROPS_WEB_ALLOWED_ORIGINS=https://drops.example.com
DROPS_WEB_SESSION_SECRET=change-me-to-a-long-random-string
DROPS_WEB_COOKIE_SECURE=true
# DROPS_WEB_STATE_DIR=/data
# DROPS_WEB_SESSION_TTL_SECONDS=86400
# DROPS_WEB_ARTIFACT_TTL_SECONDS=600
# DROPS_WEB_MAX_QUEUED=20
# DROPS_WEB_MAX_CONCURRENT=2
# DROPS_WEB_MAX_DURATION_SECONDS=900
# DROPS_WEB_MAX_FILE_BYTES=100000000

# --- Supabase Postgres (Sezione 3: cloud catalog) --------------------------
# Full SQLAlchemy/psycopg2 connection string from Supabase (Project Settings ->
# Database -> Connection string -> URI). "postgres://" and "postgresql://" are
# both accepted; they are normalised to the psycopg2 driver internally.
# If unset, the backend falls back to a local SQLite file (dev/test only).
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# --- Cloudflare R2 (Sezione 3: audio object storage) -----------------------
# All four are required to enable R2. If any is missing, downloads stay local
# (no cloud upload / streaming), so dev works with zero R2 setup.
DROPS_R2_ACCOUNT_ID=your_cloudflare_account_id
DROPS_R2_ACCESS_KEY_ID=your_r2_access_key_id
DROPS_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
DROPS_R2_BUCKET=drops-library
# Optional: override the derived endpoint (defaults to
# https://<account_id>.r2.cloudflarestorage.com)
# DROPS_R2_ENDPOINT_URL=
# Presigned URL lifetime in seconds (default 3600 = 1h; max 7 days)
# DROPS_R2_PRESIGN_TTL_SECONDS=3600
#
# For the Academy direct-to-R2 browser upload (presigned POST) to work from
# the frontend's origin, the R2 bucket itself needs a CORS policy allowing
# POST from DROPS_WEB_ALLOWED_ORIGINS - this is bucket-level Cloudflare
# config (dashboard or `wrangler r2 bucket cors`), not something this backend
# sets; there is no boto3 call in the upload path that needs it, only the
# browser's direct POST does.

# --- Academy (Sezione: DJ Lab / Academy feedback-track submissions) --------
# Max size for a student's direct-to-R2 WAV/MP3 upload. Independent from
# DROPS_WEB_MAX_FILE_BYTES (that one bounds yt-dlp downloads).
# DROPS_ACADEMY_MAX_UPLOAD_BYTES=100000000

# --- yt-dlp (existing, optional) -------------------------------------------
# Netscape cookies exported from a dedicated YouTube account. On Render prefer
# Secret File `/etc/secrets/youtube-cookies.txt`; refresh when YouTube revokes it.
# DROPS_YTDLP_COOKIES=/etc/secrets/youtube-cookies.txt
# DROPS_YTDLP_PROXY=
